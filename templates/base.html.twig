<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}MiCartera{% endblock %}</title>
        <link rel="icon" type="image/x-icon" href="/favicon.ico"/>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
            {{ encore_entry_link_tags('navMenu') }}
        {% endif %}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
<body>
    <div class="pageContainer">
        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
        {{ include('reusables/_menu.html.twig') }}
        {% endif %}
        <div class="body">   
            {% for message in app.flashes('error') %}
            <div class="flash-error">{{ message | raw }}</div>
            {% endfor %} 
            {% for message in app.flashes('success') %}
            <div class="flash-success">{{ message | raw }}</div>
            {% endfor %} 
            {% block body %}{% endblock %}
        </div>
        <div class="footer">
            <label class="themeSelector">
                Theme
                <select id="themeSelector" aria-label="Theme">
                    <option value="dark">Dark</option>
                    <option value="light">Light</option>
                    <option value="os">OS</option>
                </select>
            </label>
            <span>({{ APP_RELEASE }}) {{ 'poweredBy' | trans }} © <a href="https://www.xver.net" target="_blank">xVer</a></span>
        </div>
    </div>
</body>
</html>
