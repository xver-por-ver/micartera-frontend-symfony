<form method="post" action="{{ path('cashdividend_delete', {'id': cashDividend.getId()}) }}" onsubmit="return confirm('{{ 'confirmDeleteCashDividendMsg'|trans }}');" class="deleteForm">
    <input type="hidden" name="_method" value="DELETE" />
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cashDividend.getId()) }}" />
    <button id="cmdDelete_{{ cashDividend.getId() }}" name="cmdDelete_{{ cashDividend.getId() }}">{{ 'delete'|trans }}</button>
</form>
