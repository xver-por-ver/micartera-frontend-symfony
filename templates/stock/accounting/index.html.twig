{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('form') }}
    {{ encore_entry_link_tags('table') }}
{% endblock %}

{% block title %}{{ 'accounting'|trans|capitalize }}{% endblock %}

{% block body %}
    {% set activeEventTab = app.request.query.get('view') == 'dividends' ? 'dividends' : 'stocks' %}
    <h1>{{ 'accounting'|trans|capitalize }}</h1>

    {% set timezone =  accounting.getAccount().getTimeZone() %}
    {% set currencysymbol = accounting.getAccount().getCurrency().getSymbol() %}
    {% set yearProfitPrice = accounting.getSummary().getDisplayedYearProfitPrice().getValue() %}
    {% if yearProfitPrice >= 0 %}
        {% set yearPercentStyle = "positivePercent" %}
        {% set yearValueStyle = "positiveValue" %}
        {% set yearValueSign = "+" %}
        {% set yearPercentArrow = "M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" %}
    {% else %}
        {% set yearPercentStyle = "negativePercent" %}
        {% set yearValueStyle = "negativeValue" %}
        {% set yearValueSign = "" %}
        {% set yearPercentArrow = "M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" %}
    {% endif %}
    {% set totalProfitPrice = accounting.getSummary().getAllTimeProfitPrice().getValue() %}
    {% set allTimeCombinedNetResult = accounting.getAllTimeCombinedNetResult().getValue() %}
    {% set displayedYearCombinedNetResult = accounting.getDisplayedYearCombinedNetResult().getValue() %}
    {% set allTimeCombinedStyle = allTimeCombinedNetResult >= 0 ? 'positiveValue' : 'negativeValue' %}
    {% set allTimeCombinedSign = allTimeCombinedNetResult >= 0 ? '+' : '' %}
    {% set displayedYearCombinedStyle = displayedYearCombinedNetResult >= 0 ? 'positiveValue' : 'negativeValue' %}
    {% set displayedYearCombinedSign = displayedYearCombinedNetResult >= 0 ? '+' : '' %}
    {% if totalProfitPrice >= 0 %}
        {% set totalPercentStyle = "positivePercent" %}
        {% set totalValueStyle = "positiveValue" %}
        {% set totalValueSign = "+" %}
        {% set totalPercentArrow = "M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" %}
    {% else %}
        {% set totalPercentStyle = "negativePercent" %}
        {% set totalValueStyle = "negativeValue" %}
        {% set totalValueSign = "" %}
        {% set totalPercentArrow = "M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" %}
    {% endif %}

    <h2>{{ 'summary' | trans }}</h2>
    <table id="stock-accounting-summary" class="centered">
        <thead>
            <tr>
                <td class="noBg">&nbsp;</td>
                <th colspan="6" scope="colgroup">{{ 'stockRealizations'|trans }} {{ currencysymbol }}</th>
                <th colspan="3" scope="colgroup">{{ 'cashDividends'|trans }} {{ currencysymbol }}</th>
                <td class="noBg">&nbsp;</th>
            </tr>
            <tr>
                <td class="noBg">&nbsp;</td>
                <th scope="col">{{ 'transactionShortGross' | trans({'type': 'acquisition', 'currency': ''}) }}</th>
                <th scope="col">{{ 'transactionShortGross' | trans({'type': 'liquidation', 'currency': ''}) }}</th>
                <th scope="col">{{ 'transactionShortExpenses' | trans({'type': 'acquisition', 'currency': ''}) }}</th>
                <th scope="col">{{ 'transactionShortExpenses' | trans({'type': 'acquisition', 'currency': ''}) }}</th>
                <th scope="col">{{ 'net' | trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'net' | trans({'currency': '%'}) }}</th>
                <th scope="col">{{ 'gross'|trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'expenses'|trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'net'|trans({'currency': ''}) }} </th>
                <th scope="col">{{ 'netResult'|trans({'currency': currencysymbol}) }}</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ 'allTime' | trans }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getAllTimeAcquisitionsPrice().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getAllTimeLiquidationsPrice().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getAllTimeAcquisitionsExpenses().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getAllTimeLiquidationsExpenses().getValue()}) }}</td>
                <td class="number {{ totalValueStyle }}">{{ totalValueSign }}{{ include('reusables/format_number/decimal.html.twig', {number: totalProfitPrice}) }}</td>
                <td class="number {{ totalPercentStyle }}">
                    {{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getAllTimeProfitPercentage().getValue()}) }}
                    <svg focusable="false" viewBox="0 0 24 16">
                        <path d="{{ totalPercentArrow }}"></path>
                    </svg>
                </td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getCashDividendSummary().getAllTimeGross().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getCashDividendSummary().getAllTimeExpenses().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getCashDividendSummary().getAllTimeNet().getValue()}) }}</td>
                <td class="number {{ allTimeCombinedStyle }}">{{ allTimeCombinedSign }}{{ include('reusables/format_number/decimal.html.twig', {number: allTimeCombinedNetResult}) }}</td>
            </tr>
            <tr>
                <td>
                    <form id="accounting-year-form" method="get" action="{{ path('stockaccounting_index') }}">
                        <input type="hidden" name="view" value="{{ activeEventTab }}" />
                        <label for="accounting-year">{{ 'year'|trans }}</label>
                        <select id="accounting-year" name="year" onchange="this.form.submit()">
                            {% for year in accounting.getYearFirstOperation()..accounting.getCurrentYear() %}
                                <option value="{{ year }}"{% if accounting.getDisplayedYear() == year %} selected="selected"{% endif %}>{{ year }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getDisplayedYearAcquisitionsPrice().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getDisplayedYearLiquidationsPrice().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getDisplayedYearAcquisitionsExpenses().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getDisplayedYearLiquidationsExpenses().getValue()}) }}</td>
                <td class="number {{ yearValueStyle }}">{{ yearValueSign }}{{ include('reusables/format_number/decimal.html.twig', {number: yearProfitPrice}) }}</td>
                <td class="number {{ yearPercentStyle }}">
                    {{ include('reusables/format_number/decimal.html.twig', {number: accounting.getSummary().getDisplayedYearProfitPercentage().getValue()}) }}
                    <svg focusable="false" viewBox="0 0 24 16">
                        <path d="{{ yearPercentArrow }}"></path>
                    </svg>
                </td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getCashDividendSummary().getDisplayedYearGross().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getCashDividendSummary().getDisplayedYearExpenses().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getCashDividendSummary().getDisplayedYearNet().getValue()}) }}</td>
                <td class="number {{ displayedYearCombinedStyle }}">{{ displayedYearCombinedSign }}{{ include('reusables/format_number/decimal.html.twig', {number: displayedYearCombinedNetResult}) }}</td>
            </tr>
        </tbody>
    </table>


    <div id="accounting-event-tabs" role="tablist" aria-label="{{ 'accountingEventLists'|trans }}">
        <button type="button" id="stocks-tab" role="tab" aria-selected="{{ activeEventTab == 'stocks' ? 'true' : 'false' }}" aria-controls="stocks-panel"{% if activeEventTab != 'stocks' %} tabindex="-1"{% endif %}>{{ 'stocksTab'|trans }}</button>
        <button type="button" id="dividends-tab" role="tab" aria-selected="{{ activeEventTab == 'dividends' ? 'true' : 'false' }}" aria-controls="dividends-panel"{% if activeEventTab != 'dividends' %} tabindex="-1"{% endif %}>{{ 'dividendsTab'|trans }}</button>
    </div>

    <section id="stocks-panel" role="tabpanel" aria-labelledby="stocks-tab"{% if activeEventTab != 'stocks' %} hidden{% endif %}>
    <h2>{{ 'yearStockEvents' | trans({'year': accounting.getDisplayedYear()}) }}</h2>
    {% if accounting.getHasPrevPage() and accounting.getPage() > 0 %}
    <a href="{{ path('stockaccounting_index') }}?year={{ accounting.getDisplayedYear() }}&page={{ accounting.getPage()-1 }}" class="actionItem">{%trans%}previousPage{%endtrans%}</a>
    {% else %}
    <span class="disabledItem">{%trans%}previousPage{%endtrans%}</span>
    {% endif %}
    {% if accounting.getHasNextPage() %}
    <a href="{{ path('stockaccounting_index') }}?year={{ accounting.getDisplayedYear() }}&page={{ accounting.getPage()+1 }}" class="actionItem">{%trans%}nextPage{%endtrans%}</a>
    {% else %}
    <span class="disabledItem">{%trans%}nextPage{%endtrans%}</span>
    {% endif %}
    <table>
        <thead>
            <tr>
                <td colspan="5" class="noBg">&nbsp;</td>
                <th colspan="3" scope="colgroup">{{ 'acquisition'| trans({'amount': 2}) }} {{ currencysymbol }}</th>
                <th colspan="3" scope="colgroup">{{ 'liquidation'| trans({'amount': 2}) }} {{ currencysymbol }}</th>
                <td colspan="2" class="noBg">&nbsp;</td>
                <td class="noBg">&nbsp;</td>
            </tr>
            <tr>
                <th scope="col">
                    <div class="colSort">
                        <span>
                            <svg focusable="false" viewBox="0 0 24 16">
                                <path d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"></path>
                            </svg>
                        </span>
                        <span>{{ 'transactionShortDate' | trans({'type': ''}) }}</span>
                    </div>
                </th>
                <th scope="col">{{ 'transactionShortDate' | trans({'type': 'acquisition'}) }}</th>
                <th scope="col">{{ 'realizedHoldingDays'| trans }}</th>
                <th scope="col">{{ 'stocks'| trans({'amount': 1}) }}</th>
                <th scope="col">{{ 'shares'| trans }}</th>
                <th scope="col">{{ 'perShare' | trans }}</th>
                <th scope="col">{{ 'gross' | trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'expenses' | trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'perShare' | trans }}</th>
                <th scope="col">{{ 'gross' | trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'expenses' | trans({'currency': ''}) }}</th>
                <th scope="col">{{ 'net' | trans({'currency': currencysymbol}) }}</th>
                <th scope="col">{{ 'net' | trans({'currency': '%'}) }}</th>
                <th scope="col">{{ 'actions'| trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for accountingMovement in accounting.getCollection() %}
            <tr>
                 {% if accounting.getMovementProfitPrice(loop.index0).getValue() >= 0 %}
                    {% set percentStyle = "positivePercent" %}
                    {% set valueStyle = "positiveValue" %}
                    {% set valueSign = "+" %}
                    {% set percentArrow = "M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" %}
                {% else %}
                    {% set percentStyle = "negativePercent" %}
                    {% set valueStyle = "negativeValue" %}
                    {% set valueSign = "" %}
                    {% set percentArrow = "M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" %}
                {% endif %}
                <td>{{ accountingMovement.getLiquidation().datetimeutc | date('M d H:i:s', timezone) }}</td>
                <td>{{ accountingMovement.getAcquisition().datetimeutc | date('Y M d H:i:s', timezone) }}</td>
                <td class="number">{{ date(accountingMovement.getLiquidation().datetimeutc).diff(date(accountingMovement.getAcquisition().datetimeutc)).days }}</td>
                <td>
                    <a href="{{ path('stock_update', {'id': accountingMovement.getLiquidation().getStock().getId()}) }}" class="actionItem">{{ accountingMovement.getLiquidation().getStock().getId() }} - {{ accountingMovement.getLiquidation().getStock().getExchange.getCode() }}</a> {{ accountingMovement.getLiquidation().getStock().getName() }}
                </td>
                <td class="number">{{ include('reusables/format_number/transactionAmount.html.twig', {number: accountingMovement.getAmount().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/stock.html.twig', {number: accountingMovement.getAcquisition().getPrice().getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/stock.html.twig', {number: accounting.getMovementAcquisitionPrice(loop.index0).getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getMovementAcquisitionExpense(loop.index0).getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/stock.html.twig', {number: accountingMovement.getLiquidation().getPrice().getValue()}) }}</td>                
                <td class="number">{{ include('reusables/format_number/stock.html.twig', {number: accounting.getMovementLiquidationPrice(loop.index0).getValue()}) }}</td>
                <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getMovementLiquidationExpense(loop.index0).getValue()}) }}</td>
                <td class="number {{ valueStyle }}">
                    {{ valueSign }}{{ include('reusables/format_number/decimal.html.twig', {number: accounting.getMovementProfitPrice(loop.index0).getValue()}) }}
                </td>
                <td class="number {{ percentStyle }}">
                    {{ include('reusables/format_number/decimal.html.twig', {number: accounting.getMovementProfitPercentage(loop.index0).getValue()}) }}
                    <svg focusable="false" viewBox="0 0 24 16">
                        <path d="{{ percentArrow }}"></path>
                    </svg>
                </td>
                <td class="actions">
                    {{ include('stock/accounting/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="14">{{ 'noRecordsFound'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </section>

    <section id="dividends-panel" role="tabpanel" aria-labelledby="dividends-tab"{% if activeEventTab != 'dividends' %} hidden{% endif %}>
        <h2>{{ 'yearDividendEvents'|trans({'year': accounting.getDisplayedYear()}) }}</h2>
        <table id="dividend-events">
            <thead>
                <tr>
                    <th scope="col">{{ 'dateWithTZ'|trans({'timezone': timezone.getName()}) }}</th>
                    <th scope="col">{{ 'stocks'|trans({'amount': 1}) }}</th>
                    <th scope="col">{{ 'shares'|trans }}</th>
                    <th scope="col">{{ 'perShare'|trans({'currency': currencysymbol}) }}</th>
                    <th scope="col">{{ 'gross'|trans({'currency': currencysymbol}) }}</th>
                    <th scope="col">{{ 'expenses'|trans({'currency': currencysymbol}) }} {{ currencysymbol }}</th>
                    <th scope="col">{{ 'net'|trans({'currency': currencysymbol}) }} {{ currencysymbol }}</th>
                    <th scope="col">{{ 'actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for cashDividend in accounting.getCashDividendSummary().getDisplayedYearDividends() %}
                    <tr>
                        <td>{{ cashDividend.getDateTimeUtc()|date('Y M d H:i:s', timezone) }}</td>
                        <td><a href="{{ path('stock_update', {'id': cashDividend.getStock().getId()}) }}" class="actionItem">{{ cashDividend.getStock().getId() }} - {{ cashDividend.getStock().getExchange().getCode() }}</a> {{ cashDividend.getStock().getName() }}</td>
                        <td class="number">{{ include('reusables/format_number/transactionAmount.html.twig', {number: cashDividend.getAmount().getValue()}) }}</td>
                        <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: cashDividend.getDividendPerShare().getValue()}) }}</td>
                        <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: cashDividend.getTotalDividendPayment().getValue()}) }}</td>
                        <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: cashDividend.getExpenses().getValue()}) }}</td>
                        <td class="number">{{ include('reusables/format_number/decimal.html.twig', {number: cashDividend.getNetDividendPayment().getValue()}) }}</td>
                        <td>
                            <a href="{{ path('cashdividend_edit', {'id': cashDividend.getId()}) }}" class="actionItem">{{ 'editCashDividend'|trans }}</a>
                            {{ include('stock/dividend/_delete_form.html.twig', {cashDividend: cashDividend}) }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8">{{ 'noRecordsFound'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <script>
        document.querySelectorAll('#accounting-event-tabs [role="tab"]').forEach((tab) => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('#accounting-event-tabs [role="tab"]').forEach((item) => {
                    const selected = item === tab;
                    item.setAttribute('aria-selected', selected ? 'true' : 'false');
                    item.tabIndex = selected ? 0 : -1;
                    document.getElementById(item.getAttribute('aria-controls')).hidden = !selected;
                });
                const selectedView = tab.id === 'dividends-tab' ? 'dividends' : 'stocks';
                document.querySelector('#accounting-year-form input[name="view"]').value = selectedView;
                const url = new URL(window.location.href);
                url.searchParams.set('view', selectedView);
                window.history.replaceState({}, '', url.toString());
            });
        });
    </script>

{% endblock %}
